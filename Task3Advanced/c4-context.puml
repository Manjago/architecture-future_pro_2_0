@startuml c4-context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Целевая архитектура «Будущее 2.0» — System Context (горизонт 3 года)

' === Персоны ===

Person(operator, "Оператор клиники", "Работает с пациентами,\nведёт приём, назначает\nисследования")
Person(doctor, "Врач", "Ставит диагнозы,\nназначает лечение,\nиспользует ИИ-ассистента")
Person(analyst, "Бизнес-аналитик", "Строит отчёты,\nанализирует показатели\nчерез Self-Service BI")
Person(fintech_user, "Финтех-пользователь", "Оформляет кредиты,\nуправляет счетами,\nстраховые операции")
Person(admin, "Администратор", "Управляет инфраструктурой,\nмониторинг, доступы")

' === Наша система ===

System(future20, "Платформа «Будущее 2.0»", "Событийная платформа:\nмедицинские, финансовые,\nаналитические и ИИ-сервисы.\nДомены взаимодействуют\nчерез события.")

' === Внешние системы ===

System_Ext(pharma, "Фармацевтические\nкомпании", "Поставка лекарств,\nобмен данными\nпо назначениям")
System_Ext(electronics, "Производитель\nмед. оборудования", "Интеграция с\nдиагностическим\nоборудованием")
System_Ext(payment, "Платёжные системы", "Процессинг платежей,\nэквайринг")
System_Ext(regulator, "Регуляторы", "ЦБ, Росздравнадзор,\nРоскомнадзор:\nотчётность, комплаенс")
System_Ext(cloud, "Облачный провайдер", "Вычислительные ресурсы,\nmanaged-сервисы,\nхранилища")

' === Связи персон с системой ===

Rel(operator, future20, "Регистрирует пациентов,\nведёт приём", "Web UI")
Rel(doctor, future20, "Диагностика с ИИ,\nназначения, мед. карты", "Web UI")
Rel(analyst, future20, "Строит отчёты,\nконструирует витрины", "Self-Service BI Portal")
Rel(fintech_user, future20, "Кредиты, счета,\nфинансовые операции", "Web UI / Mobile")
Rel(admin, future20, "Мониторинг, управление\nинфраструктурой", "Admin UI / CLI")

' === Связи с внешними системами ===

Rel(future20, pharma, "Данные по назначениям\nи закупкам", "API")
Rel(future20, electronics, "Результаты исследований\nс оборудования", "API / HL7")
Rel(future20, payment, "Платёжные транзакции", "API")
Rel(future20, regulator, "Регуляторная отчётность", "API / Файлы")
Rel(future20, cloud, "Инфраструктура,\nmanaged-сервисы", "Terraform / API")

@enduml
